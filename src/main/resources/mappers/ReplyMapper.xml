<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
	
<mapper namespace="kr.or.oti.mapper.ReplyMapper">
	
	<select id="selectAll" resultType="kr.or.oti.domain.ReplyVO">
		SELECT *
		FROM REPLY
		WHERE BNO = #{bno}
		ORDER BY RNO DESC
	</select>
	
	<select id="selectOne" resultType="kr.or.oti.domain.ReplyVO">
		SELECT *
		FROM REPLY
		WHERE RNO = #{rno}
	</select>
	
	<insert id="insertOne">
		INSERT INTO REPLY
		(
			RNO,
			BNO,
			REPLY,
			REPLYER
		)
		VALUES
		(
			SEQ_REPLY.NEXTVAL,
			#{bno},
			#{reply},
			#{replyer}
		)
	</insert>
	
	<update id="updateOne">
		UPDATE REPLY
		SET
			REPLY = #{reply},
			MODDATE = SYSDATE
		WHERE RNO = #{rno}
	</update>
	
	<delete id="deleteOne">
		DELETE FROM REPLY
		WHERE RNO = #{rno}
	</delete>
	
	<delete id="deleteAllByBno">
		DELETE FROM REPLY
		WHERE BNO = #{bno}
	</delete>

</mapper>